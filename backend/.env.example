# Chave secreta da aplicação (use uma string longa e aleatória em produção)
SECRET_KEY=sua_chave_secreta_aqui_para_desenvolvimento_local

# Modo de depuração (True para desenvolvimento, False para produção)
DEBUG=True

# String de conexão com o banco de dados PostgreSQL
# Formato: postgresql://<usuario>:<senha>@<host>:<porta>/<nome_do_banco>
#
# Opção 1: Rodando a aplicação localmente na sua máquina (fora do Docker):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
#
# Opção 2: Rodando a aplicação dentro de container Docker (rede interna do docker-compose):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/app_db