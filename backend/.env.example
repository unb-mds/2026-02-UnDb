# Copie este arquivo para backend/.env e preencha os valores.
# O .env real NUNCA e commitado (ver .gitignore e CLAUDE.md).

# Chave da aplicação. Use uma string longa, aleatória e exclusiva em cada ambiente.
SECRET_KEY=troque-por-um-valor-aleatorio

# Modo de depuração (True para desenvolvimento, False para produção)
DEBUG=True

# Credenciais do PostgreSQL local em Docker. Altere a senha no backend/.env.
POSTGRES_USER=g7
POSTGRES_PASSWORD=troque-por-uma-senha-local
POSTGRES_DB=g7

# SQLAlchemy síncrono + PostgreSQL (driver psycopg2).
# No Docker Compose, o backend alcança o banco pelo nome do serviço `db`.
DATABASE_URL=postgresql+psycopg2://g7:troque-por-uma-senha-local@db:5432/g7
