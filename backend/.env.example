# Copie este arquivo para backend/.env e preencha os valores.
# O .env real NUNCA e commitado (ver .gitignore e CLAUDE.md).

# Chave da aplicação. Use uma string longa, aleatória e exclusiva em cada ambiente.
SECRET_KEY=troque-por-um-valor-aleatorio

# Modo de depuração (True para desenvolvimento, False para produção)
DEBUG=True

# Credenciais do PostgreSQL local em Docker. Altere a senha no backend/.env.
POSTGRES_USER=g7
POSTGRES_PASSWORD=troque-por-uma-senha-local
POSTGRES_DB=g7

# SQLAlchemy síncrono + PostgreSQL (driver psycopg2).
# No Docker Compose, o backend alcança o banco pelo nome do serviço `db`.
DATABASE_URL=postgresql+psycopg2://g7:troque-por-uma-senha-local@db:5432/g7

# Opcional: conexão administrativa exclusiva do Alembic. Sem ela, usa DATABASE_URL.
# No ambiente hospedado, DATABASE_URL deve usar o papel limitado da API.
# Configure o valor real somente no ambiente privado, nunca neste arquivo.
# MIGRATION_DATABASE_URL=postgresql+psycopg2://migrador:senha-local@db:5432/g7

# Origens (frontend) autorizadas para CORS e mutações/CSRF (#266), separadas por
# vírgula. Sem essa lista, o navegador bloqueia a busca de professores e
# disciplinas por CORS, mesmo a API respondendo corretamente por baixo.
CORS_ORIGINS=http://localhost:3000
# Usar origens exatas, sem caminhos ou curinga. Clientes com cookie e login devem
# enviar Origin autorizado ou Referer de origem autorizada; ver relatório #266.

# Somente com DEBUG=True: simula envio sem imprimir destinatário ou link.
# Use `resend` somente quando RESEND_API_KEY e EMAIL_FROM estiverem configurados.
EMAIL_BACKEND=console
FRONTEND_URL=http://localhost:3000
EMAIL_FROM=UnDb <onboarding@resend.dev>
# RESEND_API_KEY=re_substitua_por_uma_chave_local

# Apoio à moderação (#239). Só habilitar após validar lista, dados e acesso à API.
MODERACAO_FILTRO_ATIVO=False
# Complemento da #252: manter desligado até homologação e autorização de ativação.
MODERACAO_DISFARCES_ATIVO=False
# Ampliação numérica da #252; também exige MODERACAO_DISFARCES_ATIVO.
MODERACAO_SUBSTITUICOES_ATIVAS=False
MODERACAO_IA_ATIVA=False
MODERACAO_IA_DADOS_APROVADOS=False
# OPENAI_API_KEY=configure-somente-no-servidor
OPENAI_MODERACAO_MODEL=omni-moderation-latest
MODERACAO_IA_TIMEOUT=10
# Limites por processo; reinícios reiniciam o orçamento. Ver docs/moderacao-ia.md.
MODERACAO_IA_POR_MINUTO=5
MODERACAO_IA_POR_DIA=100

# Publicação automática somente quando filtro E IA não identificam sinais.
MODERACAO_AUTOMATICA_ATIVA=False

# #263: só ativar após retenção aprovada (#262), responsáveis e ensaio sintético.
CANAL_TITULARES_ATIVO=False
CANAL_TITULARES_RETENCAO_APROVADA=False
# UUIDs de contas confirmadas, separados por vírgula; não usar nomes ou e-mails.
CANAL_TITULARES_LEITORES=
CANAL_TITULARES_ATENDENTES=
# #266: núcleo compartilhado; autenticação e demais fluxos vinculados nos blocos 2 e 3.
# Configure segredo aleatório exclusivo no ambiente privado. Sem valor, nega por falha.
# ABUSO_HMAC_SECRET=
# Overrides por operação; {} preserva os perfis internos configuráveis de cada fluxo.
ABUSO_POLITICAS={}
# PROVISÓRIOS, pendentes de validação (item 4). Perfil genérico, não cota de e-mail.
ABUSO_QUANTIDADE_PADRAO=100
ABUSO_JANELA_SEGUNDOS_PADRAO=60
ABUSO_QUANTIDADE_GLOBAL_PADRAO=100
ABUSO_JANELA_GLOBAL_SEGUNDOS_PADRAO=60
ABUSO_STATEMENT_TIMEOUT_MS=250
ABUSO_LOCK_TIMEOUT_MS=100
ABUSO_CONNECT_TIMEOUT_SEGUNDOS=2
ABUSO_POOL_TIMEOUT_SEGUNDOS=0.25
ABUSO_POOL_TAMANHO=2
ABUSO_RETRY_FALHA_SEGUNDOS=5
ABUSO_LIMPEZA_INTERVALO_SEGUNDOS=60
ABUSO_LIMPEZA_LOTE=1000

# Autenticacao: PROVISORIOS, pendentes de validacao (item 4).
# Exige ABUSO_HMAC_SECRET privado; ausencia suspende autenticacao com 503.
AUTH_ABUSO_MODO=enforce
AUTH_ABUSO_GLOBAL_MINUTO=30
AUTH_ABUSO_MINUTO_SEGUNDOS=60
AUTH_LOGIN_MAX_TENTATIVAS=100
AUTH_LOGIN_JANELA_SEGUNDOS=900
AUTH_LOGIN_ATRASO_APOS=3
AUTH_LOGIN_ATRASO_INICIAL_SEGUNDOS=1
AUTH_LOGIN_ATRASO_MAX_SEGUNDOS=60
AUTH_EMAIL_MAX_TENTATIVAS=3
AUTH_EMAIL_JANELA_SEGUNDOS=900
AUTH_EMAIL_INTERVALO_SEGUNDOS=60
AUTH_EMAIL_DESTINO_MAX=1
AUTH_EMAIL_COTA_DIARIA_PROVEDOR=100
AUTH_EMAIL_ORCAMENTO_DIARIO=80
AUTH_EMAIL_DIA_SEGUNDOS=86400
AUTH_TOKEN_MAX_TENTATIVAS=10
AUTH_TOKEN_JANELA_SEGUNDOS=900
AUTH_REDEFINICAO_GLOBAL_MINUTO=10
AUTH_CONFIRMACAO_TTL_HORAS=24
AUTH_SESSAO_TTL_DIAS=7
AUTH_RECUPERACAO_TTL_MINUTOS=60

# Bloco 3: PROVISORIOS, pendentes de validacao (item 4).
FLUXOS_ABUSO_MODO=enforce
FLUXOS_ABUSO_JANELA_SEGUNDOS=60
FLUXOS_ABUSO_GLOBAL=300
ABUSO_AVALIACAO_QUANTIDADE=10
ABUSO_DENUNCIA_QUANTIDADE=5
ABUSO_TITULAR_CRIAR_QUANTIDADE=3
ABUSO_TITULAR_CONSULTAR_QUANTIDADE=10
ABUSO_TITULAR_COMPLEMENTAR_QUANTIDADE=3
ABUSO_MODERACAO_FILA_QUANTIDADE=60
ABUSO_MODERACAO_DECIDIR_QUANTIDADE=30
ABUSO_MODERACAO_TRIAGEM_QUANTIDADE=10
ABUSO_IDENTIDADE_FILA_QUANTIDADE=60
ABUSO_IDENTIDADE_DECIDIR_QUANTIDADE=30
ABUSO_MODERADOR_QUANTIDADE=120
ABUSO_RECONCILIADOR_QUANTIDADE=120
DENUNCIA_FALLBACK_QUANTIDADE=3
DENUNCIA_FALLBACK_JANELA_SEGUNDOS=60

# Bloco 5: janela aprovada; guarda minima de conta excluida pendente de validacao.
RETENCAO_CONTEUDO_DIAS=7
PURGA_INTERVALO_SEGUNDOS=60
PURGA_LOTE=1000

# Bloco 6: meses corridos; premissa juridica pendente de validacao.
ACESSO_RETENCAO_MESES=6
