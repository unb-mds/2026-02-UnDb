# Copie este arquivo para frontend/.env.local e preencha os valores.
# O .env.local real NUNCA é commitado (ver .gitignore).

# Base da API institucional pública do backend (sem autenticação, RF04).
# Execução local, com o backend fora do Docker:
NEXT_PUBLIC_API_URL=http://localhost:8000
# No Docker Compose, use o nome do serviço do backend (por exemplo, api):
# NEXT_PUBLIC_API_URL=http://api:8000
