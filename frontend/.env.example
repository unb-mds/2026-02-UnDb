# Copie este arquivo para frontend/.env.local e preencha os valores.
# O .env.local real NUNCA é commitado (ver .gitignore).

# Base da API institucional pública do backend (sem autenticação, RF04).
# A URL é usada também pelo navegador e precisa ser acessível fora da rede do Docker.
# É incorporada ao bundle no build; alterações exigem novo build da imagem.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Opcional: URL usada somente pelo servidor Next.js em tempo de execução.
# Sem esta variável, o servidor usa NEXT_PUBLIC_API_URL.
# O Compose configura http://backend:8000; fora do Docker, deixe comentada.
# API_INTERNAL_URL=http://localhost:8000
